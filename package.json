{
  "name": "family-hub",
  "version": "2.1.0",
  "description": "Shared family calendar & notes app",
  "main": "main/main.cjs",
  "scripts": {
    "start": "electron .",
    "prebuild": "npm run build:site",
    "build": "electron-builder build --win --x64",
    "build:site": "node scripts/build-site.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "npm run build:site && playwright test"
  },
  "build": {
    "appId": "com.familyhub.app",
    "productName": "Family Hub",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main/**/*",
      "icons/**/*",
      "site/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caradeen333-ux/family-hub.git"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
