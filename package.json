{
  "name": "family-hub",
  "version": "2.0.0",
  "description": "Shared family calendar & notes app",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --x64"
  },
  "build": {
    "appId": "com.familyhub.app",
    "productName": "Family Hub",
    "directories": { "output": "dist" },
    "win": {
      "target": "nsis",
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main/**/*",
      "icons/**/*",
      "index.html",
      "manifest.json",
      "sw.js",
      "js/**/*",
      "css/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caradeen333-ux/family-hub.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
